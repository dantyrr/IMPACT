<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.impact.weekly-update</string>

    <!-- --if-due exits in milliseconds unless the data is actually stale, so
         checking often is cheap. Monday morning is the intended slot: the
         machine is awake and plugged in at the office. The repeated Monday
         entries cover arriving late; the daily afternoon entries are the
         failsafe for travel weeks and holidays, and only fire once the data
         is 9 days old. Checks missed while asleep run at the next wake. -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/dtyrrell/Projects/IMPACT/scripts/weekly_auto_update.sh</string>
        <string>--if-due</string>
    </array>

    <key>StartCalendarInterval</key>
    <array>
        <!-- Monday: primary window, around plugging in at work -->
        <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>8</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>8</integer><key>Minute</key><integer>45</integer></dict>
        <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>14</integer><key>Minute</key><integer>0</integer></dict>
        <!-- Any day: failsafe, only acts once the data is 9 days stale -->
        <dict><key>Hour</key><integer>11</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>16</integer><key>Minute</key><integer>0</integer></dict>
    </array>

    <key>RunAtLoad</key>
    <false/>
    <key>LowPriorityIO</key>
    <true/>
    <key>Nice</key>
    <integer>5</integer>
    <key>StandardOutPath</key>
    <string>/Users/dtyrrell/Projects/IMPACT/logs/launchd-weekly-update.out</string>
    <key>StandardErrorPath</key>
    <string>/Users/dtyrrell/Projects/IMPACT/logs/launchd-weekly-update.err</string>
</dict>
</plist>
